{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@almanac/types": ["../../packages/types"],
      "@stax/logger": ["../../packages/logger"],
      "@stax/rig-db": ["../../packages/rig-db"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
